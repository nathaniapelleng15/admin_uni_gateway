# Nilai untuk BUILD PRODUKSI saja.
#
# Kenapa berkas terpisah, bukan mengubah .env:
#   .env dipakai SEMUA mode, termasuk dev. Mengubahnya ke URL produksi membuat
#   dev lokal menembak server produksi — berbahaya, apalagi saat menguji.
#   Vite memberi prioritas lebih tinggi pada .env.production saat `vite build`,
#   jadi dev tetap memakai localhost dan build produksi memakai domain asli.
#
# Kesalahan yang diperbaiki: bundle produksi pernah dibangun tanpa nilai ini,
# sehingga jatuh ke http://localhost:8000/api/v1 dan login admin di server gagal
# dengan ERR_CONNECTION_REFUSED (memanggil localhost dari komputer pengguna).

# Base path API yang dipakai Axios (prefiks /api/v1 wajib disertakan).
VITE_API_BASE_URL=https://backend-photobooth.uniinside.net/api/v1

# Basis untuk aset backend (uploads, dsb) harus sama dengan host API.
VITE_PUBLIC_BASE_URL=https://backend-photobooth.uniinside.net
